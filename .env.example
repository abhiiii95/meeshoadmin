# Copy this file to .env.local and fill in the values

# Admin login (only this email/password can sign in)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Any long random string, used to sign the login cookie
SESSION_SECRET=replace-with-a-long-random-string

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/meesho-admin

# Cloudinary (stores uploaded label PDFs and product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
